<?xml version="1.0" encoding="utf-8"?>
<!-- Minute cell of the timetable: a rounded tile with a small gap around it.
     Fill and stroke colors are set from code (ScheduleBusTimeFragment). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/busScheduleMinuteBackgroundRectangle"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="2dip" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
