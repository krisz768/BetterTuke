<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/list_item_background">

    <TextView
        android:id="@+id/BusTypeListArrNumText"
        style="@style/Widget.BetterTuke.LineBadge"
        android:layout_marginStart="20dp"
        android:background="@drawable/bus_number_background_active"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/BusTypeArrDesText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.BetterTuke.ListTitle"
        app:layout_constraintBottom_toTopOf="@+id/BusTypeLicensePlate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/BusTypeListArrNumText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/BusTypeLicensePlate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.BetterTuke.Supporting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/BusTypeArrDesText"
        app:layout_constraintStart_toStartOf="@+id/BusTypeArrDesText"
        app:layout_constraintTop_toBottomOf="@+id/BusTypeArrDesText" />

</androidx.constraintlayout.widget.ConstraintLayout>
